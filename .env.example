# "live" = real session (sign-in gate, account sync); default "mock" = fixtures, no sign-in.
NEXT_PUBLIC_API_MODE=mock
# Backend API origin only (routes already include /api/v1). Empty = same origin.
# Backend local default is http://localhost:3000; serve the frontend on another port
# (e.g. `next dev -p 3001`) and add that exact origin to the backend CORS_ORIGINS.
# Use localhost consistently (not 127.0.0.1).
NEXT_PUBLIC_API_ORIGIN=http://localhost:3000
